# Arduino IDE build artifacts
*.elf
*.hex
*.bin
*.map
# Anchored: only the root PyInstaller output is meant, never a nested build/.
/build/

# PlatformIO
.pio/
.pioenvs/
.piolibdeps/

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
# Anchored for the same reason as /build/ above.
/dist/
*.egg
.venv/
venv/
# Throwaway clean venv built by packaging/evka_gui/build_windows.ps1.
# Anchored on purpose: unanchored rules in this file have repeatedly hidden
# real tracked directories.
/.venv-build/

# Release artifacts: build_windows.ps1 and build_source_zip.sh both write their
# zip to the repo root. These belong on the GitHub release, never in git.
# Anchored and versioned-glob only, for the same reason as above.
/EvkaGUI-win64-v*.zip
/EvkaGUI-src-v*.zip
# Wine prefix for cross-building the Windows bundle on Linux.
/.wine-build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db



# Local app settings (contains network credentials/config)
settings.txt
**/settings.txt

# Research / exploration docs (not production)
docs/microros/
docs/firmware/FreeRTOS_Dual_Core_Architecture.md
docs/firmware/QUICK_REFERENCE_DualCore.md
docs/firmware/ESP32_PCNT_REFERENCE.md
docs/improvement_research.md
# Legacy flat-file patterns (kept for history, files already deleted or moved)
docs/MICROROS*.md
docs/FreeRTOS*.md
docs/ESP32_*.md
# ...but these two are current, referenced troubleshooting docs — keep them tracked:
!docs/ESP32_WDT_20HZ_QUICK_REFERENCE.md
!docs/ESP32_WIFI_AP_STA_HEAP_DRAIN_GUIDE.md
docs/README_MICROROS.md

# LaTeX build artifacts in the report folders (sources + PDFs stay tracked).
# Do NOT use a bare "report/" rule — it silently hid laser_radius/report/ (a
# documented deliverable) and report/main.tex. Same bug class as /calibration/.
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.synctex.gz
report/*.fls
report/*.fdb_latexmk
laser_radius/report/*.aux
laser_radius/report/*.log
laser_radius/report/*.out
laser_radius/report/*.toc
laser_radius/report/*.synctex.gz
laser_radius/report/*.fls
laser_radius/report/*.fdb_latexmk
docs/reports/**/*.aux
docs/reports/**/*.log
docs/reports/**/*.out
docs/reports/**/*.toc
docs/reports/**/*.synctex.gz
docs/reports/**/*.fls
docs/reports/**/*.fdb_latexmk

# Root-level calibration folder (moved to firmware/tests/) — anchored so it does
# NOT match docs/calibration/
/calibration/

# Generated endpoint-report session artifacts (keep CSV templates trackable)
docs/calibration/sessions/**/report.md
docs/calibration/sessions/**/calibration.json
docs/calibration/sessions/**/*_errors.csv

tools/__pycache__/

# KiCad
*-backups/
*.lck
~*.lck
*-bak
_autosave-*
*.orig
fp-info-cache
*.kicad_prl

# Superpowers skill/session state
.superpowers/

# Stray generated netlist at repo root (regenerate with kicad-cli sch export netlist)
/EvkaPosition_v2.net
