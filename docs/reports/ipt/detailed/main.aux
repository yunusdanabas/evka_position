\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}Error and conditioning versus sweep half-angle}{8}{subsection.8.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Target error, self-calibrated length error, sphere-fit RMS and geometric condition number versus sweep half-angle ($n=12$, $\sigma =0.1$\,mm, 16 seeds). Note the RMS is essentially flat --- the points always fit a sphere well --- while the target error spans three orders of magnitude. RMS alone is blind to the geometry; $\kappa $ tracks it.}}{8}{table.1}\protected@file@percent }
\newlabel{tab:angle}{{1}{8}{Target error, self-calibrated length error, sphere-fit RMS and geometric condition number versus sweep half-angle ($n=12$, $\sigma =0.1$\,mm, 16 seeds). Note the RMS is essentially flat --- the points always fit a sphere well --- while the target error spans three orders of magnitude. RMS alone is blind to the geometry; $\kappa $ tracks it}{table.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Left: target error (log scale) versus half-angle --- a small sweep is catastrophic. Right: geometric condition number $\kappa $ (log scale) with the \texttt  {COND\_BLOCK}$=1500$ (red) and \texttt  {COND\_WARN}$=150$ (orange) gate lines.}}{9}{figure.1}\protected@file@percent }
\newlabel{fig:angle}{{1}{9}{Left: target error (log scale) versus half-angle --- a small sweep is catastrophic. Right: geometric condition number $\kappa $ (log scale) with the \texttt {COND\_BLOCK}$=1500$ (red) and \texttt {COND\_WARN}$=150$ (orange) gate lines}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Error versus noise and point count}{9}{subsection.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: target error is \emph  {linear} in the sensor noise $\sigma $ (half-angle $35^\circ $, $n=12$) --- doubling the noise doubles the error, as \eqref  {eq:cov} predicts. Right: target error versus point count (half-angle $35^\circ $, $\sigma =0.1$\,mm) against a $1/\sqrt  {n}$ reference; more samples average the noise down but with diminishing returns.}}{9}{figure.2}\protected@file@percent }
\newlabel{fig:noise-n}{{2}{9}{Left: target error is \emph {linear} in the sensor noise $\sigma $ (half-angle $35^\circ $, $n=12$) --- doubling the noise doubles the error, as \eqref {eq:cov} predicts. Right: target error versus point count (half-angle $35^\circ $, $\sigma =0.1$\,mm) against a $1/\sqrt {n}$ reference; more samples average the noise down but with diminishing returns}{figure.2}{}}
